[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[init]
    defaultBranch = main
[push]
    default = simple
    autoSetupRemote = true
    followTags = true
[color]
    ui = auto
[core]
    excludesfile = ~/.dotfiles/git/global_gitignore
    editor = nvim
[apply]
    whitespace = nowarn
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[mergetool]
    keepBackup = false
[difftool]
    prompt = false
[credential]
    helper = cache --timeout=7200
[pull]
    rebase = true
[fetch]
    prune = true
[rebase]
    autoStash = true
[rerere]
    enabled = true
[merge]
    conflictstyle = zdiff3
[alias]
    # Compact colored log graph with refs, relative date and author
    onelog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    # Table of unmerged local branches: ahead/behind the default branch, last commit, description
    pbranch = "!~/.dotfiles/git/branches.sh"
[help]
    autocorrect = prompt
[commit]
    verbose = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[include]
    path = ~/.gitconfig.local
