export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="robbyrussell"
plugins=(
  git
  docker
  docker-compose
)

source $ZSH/oh-my-zsh.sh

source $HOME/.dotfiles/zsh/aliases.zsh
[ -f $HOME/.dotfiles/private/zsh/aliases.zsh ] && source $HOME/.dotfiles/private/zsh/aliases.zsh
source $HOME/.dotfiles/zsh/functions.zsh
source $HOME/.dotfiles/zsh/theme.zsh
source $HOME/.dotfiles/zsh/hackerman.zsh
source $HOME/.dotfiles/docker/functions.zsh

if [ -f $HOME/.base16_theme ]; then
    source $HOME/.base16_theme
fi

export NVM_DIR="$HOME/.nvm"
nvm_default_bin() {
    local version="$(cat "$NVM_DIR/alias/default" 2>/dev/null)"
    local dirs=("$NVM_DIR"/versions/node/v${version#v}*/bin(N))
    [ ${#dirs[@]} -gt 0 ] && echo "${dirs[-1]}"
}
NVM_DEFAULT_BIN="$(nvm_default_bin)"
[ -n "$NVM_DEFAULT_BIN" ] && export PATH="$NVM_DEFAULT_BIN:$PATH"
nvm() {
    unfunction nvm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
}

export ANDROID_HOME=~/Android/Sdk

export PATH=~/.local/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH

export DOCKER_BUILDKIT=1

export EDITOR=nvim
export VISUAL=nvim

export CAPACITOR_ANDROID_STUDIO_PATH=~/.local/android-studio/bin/studio.sh

export VIRTUAL_ENV_DISABLE_PROMPT=1
export VIRTUAL_ENV="$HOME/py-venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"

theme_login dark
